# 依赖与构建产物
node_modules/
.vercel/

# ★ 原始照片目录：严禁提交（DNG 原图会撑爆 Vercel 250MB 构建包）
# 原图只用于本地处理生成缩略图，处理后的缩略图放入 images/thumbnails/
photofile/

# 本地处理输出（待上传到 Cloudflare R2 的高清展示图，不进仓库）
r2-upload/

# ★ 缩略图不进仓库：所有图片走 Cloudflare R2，仓库只存代码
# 缩略图由 prepare_images.py 生成在本地，需手动上传到 R2 的 thumbs/ 目录
# 保留 .gitkeep 仅用于占位目录结构
images/thumbnails/*
!images/thumbnails/.gitkeep

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/

# 日志
*.log
npm-debug.log*

# 本地环境变量（切勿提交密钥）
.env
.env.local
